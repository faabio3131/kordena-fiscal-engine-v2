FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
# Refresh base OS packages so fixable Debian security advisories do not ship in runtime images.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 nfcore && useradd --uid 10001 --gid 10001 --no-create-home nfcore

COPY pyproject.toml README.md ./
COPY src ./src
# Unpublished four-plan candidate for platform-admin preview only.
COPY config/commercial/plans.json ./config/commercial/plans.json
COPY scripts/ci/migration_guard.py ./scripts/ci/migration_guard.py
COPY scripts/admin/provision_staging_test_account.py ./scripts/admin/provision_staging_test_account.py
RUN python -m pip install --upgrade pip && python -m pip install ".[web,postgres,telemetry]"

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=2).read()"

# Proxy-derived authority is handled explicitly by the application/edge contract.
# Uvicorn must not rewrite client/scheme from forwarding headers on its own.
# Four independent ASGI workers: each worker owns its database connection pool.
# The production deployment must verify memory/connection limits before promotion.
CMD ["uvicorn", "kordena_fiscal.runtime.api:app", "--host", "0.0.0.0", "--port", "8080", "--no-proxy-headers", "--workers", "4", "--timeout-keep-alive", "30"]
