# FM NFCORE environment contract — no real secrets belong in this file.
NFCORE_ENVIRONMENT=development
NFCORE_PERSISTENCE_BACKEND=sqlite
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NFCORE_SECRET_BACKEND=memory
NFCORE_REQUIRE_HTTPS=false
PORT=8080
# Worker smoke/startup validation only; normal runtime leaves this false/unset.
NFCORE_WORKER_ONESHOT=false
