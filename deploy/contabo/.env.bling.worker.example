# Template ONLY — no real credentials. Must be a host-side file mode 0600.
# This overlay does not appear in deploy.sh or the production cron.
NFCORE_BLING_INSTALLATIONS_ENABLED=true
NFCORE_WORKER_CONNECTOR=bling-multi
NFCORE_PUBLIC_HOSTNAME=app.nfcore.com.br
NFCORE_ALLOWED_ORIGINS=https://app.nfcore.com.br
NFCORE_REQUIRE_HTTPS=true
NFCORE_BLING_CLIENT_ID=
# Use exact scope IDs actually approved and returned by Bling OAuth; do not
# put human labels such as pedidos_vendas here without verifying the token.
NFCORE_BLING_APPROVED_SCOPES=
# Secrets are mounted from NFCORE_BLING_SECRETS_HOST_DIR (directory mode 0700)
# client-secret (also authenticates Bling webhooks), master-key (base64 AES-256).
# NFCORE_BLING_SECRETS_HOST_DIR must be provided only after approval.
# No NFCORE_BLING_COMPANY_ID/TENANT_ID/UNIT_ID/ENVIRONMENT (legacy identity).
