# HOST-OWNED example for .env.bling.api (chmod 0600). No real secrets here.
# Same OAuth client ID and approved provider scopes as the controlled worker.
# Never set legacy NFCORE_BLING_COMPANY_ID / TENANT_ID / UNIT_ID / ENVIRONMENT.
NFCORE_BLING_CLIENT_ID=
# Use the exact space-separated scope IDs returned by Bling OAuth and
# approved for this application (often numeric), NOT names invented by NFCore.
NFCORE_BLING_APPROVED_SCOPES=
# Secret files are mounted separately, as read-only, mode 0600 and UID 10001.
# Host secret directory mode 0700, readable by the API and Bling worker UID.
# Host-only Compose variable: NFCORE_BLING_SECRETS_HOST_DIR.
