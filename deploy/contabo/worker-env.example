# NFCore V1 — modelo exclusivo para worker GSM MULTIEMPRESA na Contabo.
# Arquivo de host: /opt/fm/nfcore/.env.worker (chmod 0600; NUNCA no Git).
# A identidade Google existente fica em /etc/nfcore/worker/worker-identity.json,
# UID 10001, chmod 0600 e bind READ-ONLY no compose.worker.opt-in.yml.
# A variavel NFCORE_WORKER_GSM_CREDENTIAL_FILE e fixada no overlay Compose.
# NFCORE_WORKER_IDENTITY_HOST_PATH = /etc/nfcore/worker/worker-identity.json
# deve estar em .worker-compose.env, passado via --env-file; nao na .env base.
# Nao adicionar TENANT_ID/UNIT_ID, destino ou binding fixo: o modo multiempresa
# obtem escopos exatos no PostgreSQL canonico com aprovacao de egress.
NFCORE_WORKER_GSM_MODE=multi-tenant-production-sa-v1
NFCORE_GSM_PROJECT_ID=fm-nfcore-prod
NFCORE_GSM_ALLOWED_PROJECTS=fm-nfcore-prod
NFCORE_GSM_PROJECT_NUMBER=646230745113
NFCORE_GSM_API_SERVICE_ACCOUNT=nfcore-api@fm-nfcore-prod.iam.gserviceaccount.com
NFCORE_GSM_WORKER_SERVICE_ACCOUNT=nfcore-worker@fm-nfcore-prod.iam.gserviceaccount.com
NFCORE_WORKER_GSM_HOST_NAMESPACE=nfcore
# RuntimeSettings da mesma aplicacao exige hostname HTTPS mesmo sem porta publica.
NFCORE_PUBLIC_HOSTNAME=api.nfcore.com.br
NFCORE_ALLOWED_ORIGINS=https://app.nfcore.com.br
NFCORE_REQUIRE_HTTPS=true
# Dados PUBLICOS de identificacao da chave, confirmados no Google IAM.
# NUNCA copiar a chave privada para este arquivo ou variaveis de ambiente.
NFCORE_WORKER_GSM_KEY_ID=
NFCORE_WORKER_GSM_KEY_CREATED_AT=
NFCORE_WORKER_GSM_KEY_NOT_AFTER=
